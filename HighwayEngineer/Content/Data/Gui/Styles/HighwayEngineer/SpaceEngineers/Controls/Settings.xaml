<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/ArthurGamerHD/AcruxUI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Keen-style dialog: a square, frameless window without ADK's title bar. The settings
       screen shows its own Space Engineers header and close button instead. -->
  <Style Selector="Window.settings-window">
    <Setter Property="WindowDecorations" Value="BorderOnly" />
    <Setter Property="Background" Value="{DynamicResource surfaceContainerHighColor}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="IntegerRangeSlider.settings-slider-row">
    <Setter Property="Width" Value="455" />
    <Setter Property="Height" Value="55" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="FloatRangeSlider.settings-slider-row">
    <Setter Property="Width" Value="455" />
    <Setter Property="Height" Value="55" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="SettingsRow.settings-row">
    <Setter Property="MinHeight" Value="52" />
  </Style>
</Styles>
