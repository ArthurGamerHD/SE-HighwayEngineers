<Project>
  <PropertyGroup>
    <AdkIniPath Condition="'$(AdkIniPath)' == ''">$(MSBuildProjectDirectory)\adk.ini</AdkIniPath>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Link" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Adk.Analyzer\Adk.Analyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false">
      <SetPlatform>Platform=AnyCPU</SetPlatform>
    </ProjectReference>
    <AdditionalFiles Include="$(AdkIniPath)" />
  </ItemGroup>

  <UsingTask TaskName="AdkHealIni"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <Changed ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string[] generatorKeys = new[]
        {
            "api",
            "chat",
            "client-server-boundary",
            "constants",
            "mdk-pack-test",
            "modules",
            "network",
            "singleton",
            "terminal-controls"
        };

        string content = File.Exists(FilePath) ? File.ReadAllText(FilePath) : string.Empty;
        string newLine = content.IndexOf("\r\n", StringComparison.Ordinal) >= 0
            ? "\r\n"
            : Environment.NewLine;
        var lines = new List<string>(Regex.Split(content, "\r\n|\n|\r"));
        if (lines.Count == 1 && lines[0].Length == 0)
            lines.Clear();

        int sectionStart = -1;
        int sectionEnd = lines.Count;
        for (int i = 0; i < lines.Count; i++)
        {
            string trimmed = lines[i].Trim();
            if (trimmed.Length < 2 || trimmed[0] != '[' || trimmed[trimmed.Length - 1] != ']')
                continue;

            string section = trimmed.Substring(1, trimmed.Length - 2).Trim();
            if (sectionStart >= 0)
            {
                sectionEnd = i;
                break;
            }

            if (string.Equals(section, "generators", StringComparison.OrdinalIgnoreCase))
                sectionStart = i;
        }

        if (sectionStart < 0)
        {
            while (lines.Count > 0 && lines[lines.Count - 1].Length == 0)
                lines.RemoveAt(lines.Count - 1);
            if (lines.Count > 0)
                lines.Add(string.Empty);
            sectionStart = lines.Count;
            lines.Add("[generators]");
            sectionEnd = lines.Count;
        }

        var existing = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        for (int i = sectionStart + 1; i < sectionEnd; i++)
        {
            string line = lines[i];
            int semicolon = line.IndexOf(';');
            int hash = line.IndexOf('#');
            int comment = semicolon < 0 ? hash : hash < 0 ? semicolon : Math.Min(semicolon, hash);
            if (comment >= 0)
                line = line.Substring(0, comment);

            int separator = line.IndexOf('=');
            if (separator < 0)
                separator = line.IndexOf(':');
            if (separator <= 0)
                continue;

            string key = line.Substring(0, separator).Trim()
                .Replace('_', '-')
                .Replace('.', '-');
            existing[key] = line.Substring(separator + 1).Trim();
        }

        string allValue;
        bool defaultEnabled = !existing.TryGetValue("all", out allValue) ||
            !(string.Equals(allValue, "false", StringComparison.OrdinalIgnoreCase) ||
              string.Equals(allValue, "no", StringComparison.OrdinalIgnoreCase) ||
              string.Equals(allValue, "off", StringComparison.OrdinalIgnoreCase) ||
              string.Equals(allValue, "disabled", StringComparison.OrdinalIgnoreCase) ||
              string.Equals(allValue, "0", StringComparison.OrdinalIgnoreCase));

        var missing = new List<string>();
        if (!existing.ContainsKey("all"))
            missing.Add("all = true");
        string defaultValue = defaultEnabled ? "true" : "false";
        for (int i = 0; i < generatorKeys.Length; i++)
        {
            if (!existing.ContainsKey(generatorKeys[i]))
                missing.Add(generatorKeys[i] + " = " + defaultValue);
        }

        if (missing.Count == 0)
        {
            Changed = false;
        }
        else
        {
            int insertionIndex = sectionEnd;
            while (insertionIndex > sectionStart + 1 && lines[insertionIndex - 1].Length == 0)
                insertionIndex--;
            lines.InsertRange(insertionIndex, missing);

            string directory = Path.GetDirectoryName(FilePath);
            if (!string.IsNullOrEmpty(directory))
                Directory.CreateDirectory(directory);
            File.WriteAllText(FilePath, string.Join(newLine, lines) + newLine, new UTF8Encoding(false));
            Changed = true;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="HealAdkIni" BeforeTargets="CoreCompile">
    <AdkHealIni FilePath="$(AdkIniPath)">
      <Output TaskParameter="Changed" PropertyName="AdkIniChanged" />
    </AdkHealIni>
    <Message Condition="'$(AdkIniChanged)' == 'true'"
             Importance="High"
             Text="Created or repaired ADK generator configuration: $(AdkIniPath)" />
  </Target>
</Project>
